{
	"zen.workspaces-force-container-workspace" = true;
	"zen.pinned-tab-manager.restore-pinned-tabs-to-pinned-url" = true;
	"zen.workspaces.container-specific-essentials-enabled" = true;
	"zen.workspaces.continue-where-left-off" = true;
	"zen.welcome-screen.seen" = true;
	"focusmanager.testmode" = false;

	# Habilita por padrão as extensões instaladas via Nix (sem prompt de confirmação)
	"extensions.autoDisableScopes" = 0;

	# Idioma e corretor ortográfico
	"intl.locale.requested" = "pt-BR";
	"intl.accept_languages" = "pt-BR, pt, en-US, en";
	"layout.spellcheckDefault" = 1;
	"spellchecker.dictionary" = "pt-BR";

	# Desabilita o popup automático de tradução (o botão na barra continua disponível)
	"browser.translations.automaticallyPopup" = false;
}
